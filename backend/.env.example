# Foe Agent backend configuration. Copy to .env and fill in.
FOE_DATABASE_URL=postgresql+asyncpg://foe:foe@localhost:5432/foe
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FOE_JWT_SECRET=dev-insecure-change-me
FOE_DATA_DIR=./data
FOE_CORS_ORIGINS=http://localhost:5173
FOE_MAX_UPLOAD_MB=50
